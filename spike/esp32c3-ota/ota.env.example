# Copy this file to ota.env if you want a fixed address. Without it the
# device uses DHCP and the IP is printed once at boot.
#
# A static address is what makes the USB-free workflow practical: with DHCP you
# have to look the address up in the router before every update.
WORDCLOCK_OTA_IP=192.168.1.50/24
WORDCLOCK_OTA_GATEWAY=192.168.1.1
